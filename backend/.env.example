# Copy to backend/.env for local development (gitignored).
# On Render: Dashboard -> your service -> Environment -> add each variable.

# Port is set by Render automatically; 4000 locally
PORT=4000

# Website origins allowed to call this API from a browser (comma separated, no trailing slash)
FRONTEND_ORIGINS="http://localhost:8080,https://your-site.example.com"

# Postgres connection string (Neon: Dashboard -> Connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay: Dashboard -> Account & Settings -> API Keys (use rzp_test_ keys until go-live)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Razorpay: Dashboard -> Webhooks -> secret you chose for
#   https://<your-api>.onrender.com/api/razorpay/webhook
#   (events: payment.authorized, payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET="choose-a-long-random-string"

# Registrations are closed unless this is exactly "true"
REGISTRATIONS_OPEN="false"

# ---- Firebase backup copy (Firestore). Neon stays the source of truth. ----
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# keep it on ONE line with \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Lets a scheduler call POST /api/admin/backup-sync (at least 24 random characters)
BACKUP_SYNC_TOKEN="generate-a-long-random-string-here"

# ---- Admin panel ----
# Set real values only in .env / Render — never commit them.
ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD="your-admin-password"
# Signs admin login tokens: at least 32 random characters. Changing it logs everyone out.
ADMIN_SESSION_SECRET="generate-at-least-32-random-characters-here"

# Keep-alive: the server pings its own public URL every 10 minutes so Render's free plan
# never sleeps. Render sets RENDER_EXTERNAL_URL automatically; set KEEP_ALIVE_URL only to
# override it, or KEEP_ALIVE_URL=off to disable.
# KEEP_ALIVE_URL=
