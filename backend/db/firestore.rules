rules_version = '2';

// Udgam registration backup. Only the server writes here, using a service account
// (service accounts bypass these rules). Browsers must never read or write registration
// data — it contains students' phone numbers and emails.
// Publish in Firebase Console -> Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
